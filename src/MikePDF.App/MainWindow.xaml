<Window
    x:Class="MikePDF.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MikePDF.App.Views"
    xmlns:app="using:MikePDF.App">

    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAccelerator" />
            <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="OnGoToPageAccelerator" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator" />
            <KeyboardAccelerator Key="F3" Invoked="OnFindNextAccelerator" />
            <KeyboardAccelerator Key="F3" Modifiers="Shift" Invoked="OnFindPreviousAccelerator" />
            <KeyboardAccelerator Key="F4" Invoked="OnSidebarAccelerator" />
            <KeyboardAccelerator Key="F11" Invoked="OnFullScreenAccelerator" />
            <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="OnPropertiesAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardAccelerator" />
            <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="OnActualSizeAccelerator" />
            <KeyboardAccelerator Key="NumberPad0" Modifiers="Control" Invoked="OnActualSizeAccelerator" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnFitPageAccelerator" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnFitWidthAccelerator" />
            <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="OnZoomInAccelerator" />
            <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="OnZoomOutAccelerator" />
            <KeyboardAccelerator x:Name="ZoomInOemAccelerator" Modifiers="Control" Invoked="OnZoomInAccelerator" />
            <KeyboardAccelerator x:Name="ZoomOutOemAccelerator" Modifiers="Control" Invoked="OnZoomOutAccelerator" />
            <KeyboardAccelerator x:Name="RotateRightOemAccelerator" Modifiers="Control,Shift" Invoked="OnRotateRightAccelerator" />
            <KeyboardAccelerator x:Name="RotateLeftOemAccelerator" Modifiers="Control,Shift" Invoked="OnRotateLeftAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the app owns the strip, Windows draws the caption buttons on the right. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="16" Height="16" Margin="14,0,10,0" Source="ms-appx:///Assets/Square44x44Logo.targetsize-24.png"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="TitleText" />
        </Grid>

        <CommandBar x:Name="Commands" Grid.Row="1" DefaultLabelPosition="Collapsed" Background="Transparent" IsOpen="False">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="PageIndicator" x:Uid="PageIndicator" AutomationProperties.AutomationId="PageIndicator"
                            Click="OnPageIndicatorClick" MinWidth="92" Padding="12,4" IsEnabled="False" />
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton x:Name="OpenButton" x:Uid="OpenButton" AutomationProperties.AutomationId="OpenButton" Icon="OpenFile" Click="OnOpenClick" />
            <AppBarSeparator />
            <AppBarButton x:Name="BackButton" x:Uid="BackButton" AutomationProperties.AutomationId="BackButton" Icon="Back" Click="OnBackClick" IsEnabled="False" />
            <AppBarButton x:Name="ForwardButton" x:Uid="ForwardButton" AutomationProperties.AutomationId="ForwardButton" Icon="Forward" Click="OnForwardClick" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarToggleButton x:Name="SidebarButton" x:Uid="SidebarButton" AutomationProperties.AutomationId="SidebarButton" IsEnabled="False"
                                Checked="OnSidebarToggled" Unchecked="OnSidebarToggled">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE700;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton x:Name="FindButton" x:Uid="FindButton" AutomationProperties.AutomationId="FindButton" Icon="Find" Click="OnFindClick" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarButton x:Name="ZoomOutButton" x:Uid="ZoomOutButton" AutomationProperties.AutomationId="ZoomOutButton" Icon="ZoomOut" Click="OnZoomOutClick" IsEnabled="False" />
            <AppBarButton x:Name="ZoomButton" x:Uid="ZoomButton" AutomationProperties.AutomationId="ZoomButton" IsEnabled="False" LabelPosition="Default" MinWidth="64">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71E;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="ZoomMenu">
                        <MenuFlyoutItem x:Uid="ZoomActualSize" AutomationProperties.AutomationId="ZoomActualSize" Click="OnPhysicalSizeClick" />
                        <MenuFlyoutItem x:Uid="ZoomFitWidth" AutomationProperties.AutomationId="ZoomFitWidth" Click="OnFitWidthClick" />
                        <MenuFlyoutItem x:Uid="ZoomFitPage" AutomationProperties.AutomationId="ZoomFitPage" Click="OnFitPageClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="50%" Tag="0.5" Click="OnZoomPresetClick" AutomationProperties.AutomationId="Zoom50" />
                        <MenuFlyoutItem Text="75%" Tag="0.75" Click="OnZoomPresetClick" AutomationProperties.AutomationId="Zoom75" />
                        <MenuFlyoutItem Text="100%" Tag="1" Click="OnZoomPresetClick" AutomationProperties.AutomationId="Zoom100" />
                        <MenuFlyoutItem Text="125%" Tag="1.25" Click="OnZoomPresetClick" AutomationProperties.AutomationId="Zoom125" />
                        <MenuFlyoutItem Text="150%" Tag="1.5" Click="OnZoomPresetClick" AutomationProperties.AutomationId="Zoom150" />
                        <MenuFlyoutItem Text="200%" Tag="2" Click="OnZoomPresetClick" AutomationProperties.AutomationId="Zoom200" />
                        <MenuFlyoutItem Text="400%" Tag="4" Click="OnZoomPresetClick" AutomationProperties.AutomationId="Zoom400" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="ZoomInButton" x:Uid="ZoomInButton" AutomationProperties.AutomationId="ZoomInButton" Icon="ZoomIn" Click="OnZoomInClick" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarButton x:Name="FitWidthButton" x:Uid="FitWidthButton" AutomationProperties.AutomationId="FitWidthButton" Click="OnFitWidthClick" IsEnabled="False">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE9A6;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="FitPageButton" x:Uid="FitPageButton" AutomationProperties.AutomationId="FitPageButton" Click="OnFitPageClick" IsEnabled="False">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7C3;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="RotateLeftButton" x:Uid="RotateLeftButton" AutomationProperties.AutomationId="RotateLeftButton" Click="OnRotateLeftClick" IsEnabled="False">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="RotateRightButton" x:Uid="RotateRightButton" AutomationProperties.AutomationId="RotateRightButton" Icon="Rotate" Click="OnRotateRightClick" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarButton x:Name="PageColourButton" x:Uid="PageColourButton" AutomationProperties.AutomationId="PageColourButton">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="PageColourMenu">
                        <RadioMenuFlyoutItem x:Name="PageColourNormal" x:Uid="PageColourNormal" GroupName="PageColour" Tag="Normal" Click="OnPageColourClick"
                                             AutomationProperties.AutomationId="PageColourNormal" IsChecked="True" />
                        <RadioMenuFlyoutItem x:Name="PageColourInverted" x:Uid="PageColourInverted" GroupName="PageColour" Tag="Inverted" Click="OnPageColourClick"
                                             AutomationProperties.AutomationId="PageColourInverted" />
                        <RadioMenuFlyoutItem x:Name="PageColourSepia" x:Uid="PageColourSepia" GroupName="PageColour" Tag="Sepia" Click="OnPageColourClick"
                                             AutomationProperties.AutomationId="PageColourSepia" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="PropertiesButton" x:Uid="PropertiesButton" AutomationProperties.AutomationId="PropertiesButton" Click="OnPropertiesClick" IsEnabled="False">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="FullScreenButton" x:Uid="FullScreenButton" AutomationProperties.AutomationId="FullScreenButton" Click="OnFullScreenClick">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE740;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <SplitView Grid.Row="2" x:Name="Sidebar" DisplayMode="Inline" IsPaneOpen="False" OpenPaneLength="296" PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
            <SplitView.Pane>
                <Grid x:Name="SidebarPane" AutomationProperties.AutomationId="SidebarPane" KeyDown="OnSidebarKeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="SidebarTabs" x:Uid="SidebarTabs" AutomationProperties.AutomationId="SidebarTabs" Margin="8,6" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="ThumbnailsTab" x:Uid="ThumbnailsTab" AutomationProperties.AutomationId="ThumbnailsTab" Grid.Column="0" HorizontalAlignment="Stretch" IsChecked="True"
                                      Checked="OnSidebarTabToggled" Unchecked="OnSidebarTabToggled" />
                        <ToggleButton x:Name="BookmarksTab" x:Uid="BookmarksTab" AutomationProperties.AutomationId="BookmarksTab" Grid.Column="1" HorizontalAlignment="Stretch"
                                      Checked="OnSidebarTabToggled" Unchecked="OnSidebarTabToggled" />
                    </Grid>

                    <ListView x:Name="ThumbnailList" x:Uid="ThumbnailList" Grid.Row="1" AutomationProperties.AutomationId="ThumbnailList"
                              SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnThumbnailClick" ContainerContentChanging="OnThumbnailContainerChanging"
                              HorizontalContentAlignment="Center" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="app:ThumbnailItem">
                                <StackPanel Spacing="4" AutomationProperties.Name="{x:Bind AutomationName}" AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                    <Border Width="{x:Bind Width, Mode=OneWay}" Height="{x:Bind Height, Mode=OneWay}" Background="White" BorderThickness="1"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" HorizontalAlignment="Center">
                                        <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Fill" AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Label}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid x:Name="OutlinePane" Grid.Row="1" Visibility="Collapsed">
                        <TreeView x:Name="OutlineTree" x:Uid="OutlineTree" AutomationProperties.AutomationId="OutlineTree" SelectionMode="Single"
                                  CanDragItems="False" CanReorderItems="False" AllowDrop="False" Expanding="OnOutlineExpanding" ItemInvoked="OnOutlineInvoked">
                        </TreeView>
                        <TextBlock x:Name="OutlineMessage" AutomationProperties.AutomationId="OutlineMessage" Margin="16" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </Grid>
            </SplitView.Pane>

        <Grid>
            <views:PageSurface x:Name="Pages" x:Uid="PageSurface" AutomationProperties.AutomationId="PageSurface" Visibility="Collapsed" />

            <!-- Find in the document (Ctrl+F). -->
            <Border x:Name="FindBar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,24,0" Padding="8" CornerRadius="8"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    AutomationProperties.AutomationId="FindBar" PreviewKeyDown="OnFindBarKeyDown">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox x:Name="FindBox" x:Uid="FindBox" AutomationProperties.AutomationId="FindBox" Width="220" TextChanged="OnFindTextChanged" MaxLength="128" />
                    <TextBlock x:Name="FindStatus" AutomationProperties.AutomationId="FindStatus" AutomationProperties.LiveSetting="Polite" MinWidth="110" Margin="4,0"
                               VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="FindPreviousButton" x:Uid="FindPreviousButton" AutomationProperties.AutomationId="FindPreviousButton" Click="OnFindPreviousClick">
                        <FontIcon Glyph="&#xE70E;" FontSize="14" />
                    </Button>
                    <Button x:Name="FindNextButton" x:Uid="FindNextButton" AutomationProperties.AutomationId="FindNextButton" Click="OnFindNextClick">
                        <FontIcon Glyph="&#xE70D;" FontSize="14" />
                    </Button>
                    <ToggleButton x:Name="FindMatchCaseToggle" x:Uid="FindMatchCaseToggle" AutomationProperties.AutomationId="FindMatchCaseToggle" Checked="OnFindOptionChanged" Unchecked="OnFindOptionChanged" />
                    <ToggleButton x:Name="FindWholeWordToggle" x:Uid="FindWholeWordToggle" AutomationProperties.AutomationId="FindWholeWordToggle" Checked="OnFindOptionChanged" Unchecked="OnFindOptionChanged" />
                    <ToggleButton x:Name="FindRegexToggle" x:Uid="FindRegexToggle" AutomationProperties.AutomationId="FindRegexToggle" Checked="OnFindRegexChanged" Unchecked="OnFindRegexChanged" />
                    <Button x:Name="FindCloseButton" x:Uid="FindCloseButton" AutomationProperties.AutomationId="FindCloseButton" Click="OnFindCloseClick">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Empty state: recent files, and the ways to open a PDF. -->
            <ScrollViewer x:Name="EmptyState" AutomationProperties.AutomationId="EmptyState" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="640" Margin="24,32,24,24" Spacing="16" HorizontalAlignment="Center">
                    <TextBlock x:Uid="EmptyTitle" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="EmptyTitle" />
                    <TextBlock x:Uid="EmptyHint" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                    <Button x:Name="EmptyOpenButton" x:Uid="EmptyOpenButton" AutomationProperties.AutomationId="EmptyOpenButton" Style="{StaticResource AccentButtonStyle}" Click="OnOpenClick" />
                    <TextBlock x:Uid="RecentHeading" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                    <TextBlock x:Name="NoRecentText" x:Uid="NoRecent" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="RecentList" x:Uid="RecentList" AutomationProperties.AutomationId="RecentList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="OnRecentClick" Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="app:RecentItem">
                                <StackPanel Padding="0,6" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Folder}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <InfoBar x:Name="Banner" AutomationProperties.AutomationId="Banner" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,8,16,0" MaxWidth="720"
                     IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="BannerAction" AutomationProperties.AutomationId="BannerAction" Visibility="Collapsed" Click="OnBannerActionClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <ProgressRing x:Name="Busy" x:Uid="Busy" AutomationProperties.AutomationId="Busy" IsActive="False" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        </SplitView>
    </Grid>
</Window>
