<Window
    x:Class="MikePDF.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MikePDF.App.Views"
    xmlns:app="using:MikePDF.App">

    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the tabs live in it (master prompt 7.6). The app owns the strip, Windows draws the caption buttons on the right; only the empty part after the tabs drags the window. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="16" Height="16" Margin="14,0,10,0" Source="ms-appx:///Assets/Square44x44Logo.targetsize-24.png"
                   AutomationProperties.AccessibilityView="Raw" />
            <TabView x:Name="Tabs" Grid.Column="1" AutomationProperties.AutomationId="DocumentTabs" Background="Transparent" VerticalAlignment="Bottom"
                     IsAddTabButtonVisible="False" CanReorderTabs="True" CanDragTabs="True" AllowDropTabs="True" CanTearOutTabs="True"
                     TabWidthMode="Equal" CloseButtonOverlayMode="Auto">
                <TabView.TabStripFooter>
                    <Grid x:Name="TabStripFooter" MinWidth="40" ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NewTabButton" AutomationProperties.AutomationId="NewTabButton" Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                        </Button>
                        <Grid x:Name="TitleDragRegion" Grid.Column="1" MinWidth="24" Background="Transparent" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </TabView.TabStripFooter>
            </TabView>
        </Grid>

        <CommandBar x:Name="Commands" Grid.Row="1" DefaultLabelPosition="Collapsed" Background="Transparent" IsOpen="False">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="PageIndicator" AutomationProperties.AutomationId="PageIndicator"
                            MinWidth="92" Padding="12,4" IsEnabled="False" />
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton x:Name="OpenButton" AutomationProperties.AutomationId="OpenButton" Icon="OpenFile" />
            <AppBarSeparator />
            <AppBarButton x:Name="BackButton" AutomationProperties.AutomationId="BackButton" Icon="Back" IsEnabled="False" />
            <AppBarButton x:Name="ForwardButton" AutomationProperties.AutomationId="ForwardButton" Icon="Forward" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarToggleButton x:Name="SidebarButton" AutomationProperties.AutomationId="SidebarButton" IsEnabled="False"
                                Checked="OnSidebarToggled" Unchecked="OnSidebarToggled">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE700;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton x:Name="FindButton" AutomationProperties.AutomationId="FindButton" Icon="Find" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarButton x:Name="ZoomOutButton" AutomationProperties.AutomationId="ZoomOutButton" Icon="ZoomOut" IsEnabled="False" />
            <AppBarButton x:Name="ZoomButton" x:Uid="ZoomButton" AutomationProperties.AutomationId="ZoomButton" IsEnabled="False" LabelPosition="Default" MinWidth="64">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71E;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="ZoomMenu">
                        <MenuFlyoutItem x:Name="ZoomActualSizeItem" AutomationProperties.AutomationId="ZoomActualSize" />
                        <MenuFlyoutItem x:Name="ZoomFitWidthItem" AutomationProperties.AutomationId="ZoomFitWidth" />
                        <MenuFlyoutItem x:Name="ZoomFitPageItem" AutomationProperties.AutomationId="ZoomFitPage" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="50%" Tag="0.5" AutomationProperties.AutomationId="Zoom50" />
                        <MenuFlyoutItem Text="75%" Tag="0.75" AutomationProperties.AutomationId="Zoom75" />
                        <MenuFlyoutItem Text="100%" Tag="1" AutomationProperties.AutomationId="Zoom100" />
                        <MenuFlyoutItem Text="125%" Tag="1.25" AutomationProperties.AutomationId="Zoom125" />
                        <MenuFlyoutItem Text="150%" Tag="1.5" AutomationProperties.AutomationId="Zoom150" />
                        <MenuFlyoutItem Text="200%" Tag="2" AutomationProperties.AutomationId="Zoom200" />
                        <MenuFlyoutItem Text="400%" Tag="4" AutomationProperties.AutomationId="Zoom400" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="ZoomInButton" AutomationProperties.AutomationId="ZoomInButton" Icon="ZoomIn" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarButton x:Name="FitWidthButton" AutomationProperties.AutomationId="FitWidthButton" IsEnabled="False">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE9A6;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="FitPageButton" AutomationProperties.AutomationId="FitPageButton" IsEnabled="False">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7C3;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="ViewButton" x:Uid="ViewButton" AutomationProperties.AutomationId="ViewButton" IsEnabled="False">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8A9;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="ViewMenu">
                        <RadioMenuFlyoutItem x:Name="LayoutSingleItem" GroupName="PageLayout" AutomationProperties.AutomationId="LayoutSingle" />
                        <RadioMenuFlyoutItem x:Name="LayoutTwoItem" GroupName="PageLayout" AutomationProperties.AutomationId="LayoutTwo" />
                        <RadioMenuFlyoutItem x:Name="LayoutTwoCoverItem" GroupName="PageLayout" AutomationProperties.AutomationId="LayoutTwoCover" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="LayoutContinuousItem" AutomationProperties.AutomationId="LayoutContinuous" />
                        <ToggleMenuFlyoutItem x:Name="LayoutCoverPageItem" AutomationProperties.AutomationId="LayoutCoverPage" />
                        <MenuFlyoutSubItem x:Name="DirectionMenu" x:Uid="DirectionMenu" AutomationProperties.AutomationId="DirectionMenu">
                            <RadioMenuFlyoutItem x:Name="DirectionAutoItem" GroupName="ReadingDirection" AutomationProperties.AutomationId="DirectionAuto" />
                            <RadioMenuFlyoutItem x:Name="DirectionLtrItem" GroupName="ReadingDirection" AutomationProperties.AutomationId="DirectionLtr" />
                            <RadioMenuFlyoutItem x:Name="DirectionRtlItem" GroupName="ReadingDirection" AutomationProperties.AutomationId="DirectionRtl" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="PresentationItem" AutomationProperties.AutomationId="ViewPresentation" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="RotateLeftButton" AutomationProperties.AutomationId="RotateLeftButton" IsEnabled="False">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="RotateRightButton" AutomationProperties.AutomationId="RotateRightButton" Icon="Rotate" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarButton x:Name="PageColourButton" x:Uid="PageColourButton" AutomationProperties.AutomationId="PageColourButton">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="PageColourMenu">
                        <RadioMenuFlyoutItem x:Name="PageColourNormal" x:Uid="PageColourNormal" GroupName="PageColour" Tag="Normal"
                                             AutomationProperties.AutomationId="PageColourNormal" IsChecked="True" />
                        <RadioMenuFlyoutItem x:Name="PageColourInverted" x:Uid="PageColourInverted" GroupName="PageColour" Tag="Inverted"
                                             AutomationProperties.AutomationId="PageColourInverted" />
                        <RadioMenuFlyoutItem x:Name="PageColourSepia" x:Uid="PageColourSepia" GroupName="PageColour" Tag="Sepia"
                                             AutomationProperties.AutomationId="PageColourSepia" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="PropertiesButton" AutomationProperties.AutomationId="PropertiesButton" IsEnabled="False">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="FullScreenButton" AutomationProperties.AutomationId="FullScreenButton">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE740;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <SplitView Grid.Row="2" x:Name="Sidebar" DisplayMode="Inline" IsPaneOpen="False" OpenPaneLength="296" PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
            <SplitView.Pane>
                <Grid x:Name="SidebarPane" AutomationProperties.AutomationId="SidebarPane" KeyDown="OnSidebarKeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="SidebarTabs" x:Uid="SidebarTabs" AutomationProperties.AutomationId="SidebarTabs" Margin="8,6" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="ThumbnailsTab" x:Uid="ThumbnailsTab" AutomationProperties.AutomationId="ThumbnailsTab" Grid.Column="0" HorizontalAlignment="Stretch" IsChecked="True"
                                      Checked="OnSidebarTabToggled" Unchecked="OnSidebarTabToggled" />
                        <ToggleButton x:Name="BookmarksTab" x:Uid="BookmarksTab" AutomationProperties.AutomationId="BookmarksTab" Grid.Column="1" HorizontalAlignment="Stretch"
                                      Checked="OnSidebarTabToggled" Unchecked="OnSidebarTabToggled" />
                    </Grid>

                    <ListView x:Name="ThumbnailList" x:Uid="ThumbnailList" Grid.Row="1" AutomationProperties.AutomationId="ThumbnailList"
                              SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnThumbnailClick" ContainerContentChanging="OnThumbnailContainerChanging"
                              HorizontalContentAlignment="Center" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="app:ThumbnailItem">
                                <StackPanel Spacing="4" AutomationProperties.Name="{x:Bind AutomationName}" AutomationProperties.AutomationId="{x:Bind AutomationId}">
                                    <Border Width="{x:Bind Width, Mode=OneWay}" Height="{x:Bind Height, Mode=OneWay}" Background="White" BorderThickness="1"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" HorizontalAlignment="Center">
                                        <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Fill" AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Label}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid x:Name="OutlinePane" Grid.Row="1" Visibility="Collapsed">
                        <TreeView x:Name="OutlineTree" x:Uid="OutlineTree" AutomationProperties.AutomationId="OutlineTree" SelectionMode="Single"
                                  CanDragItems="False" CanReorderItems="False" AllowDrop="False" Expanding="OnOutlineExpanding" ItemInvoked="OnOutlineInvoked">
                        </TreeView>
                        <TextBlock x:Name="OutlineMessage" AutomationProperties.AutomationId="OutlineMessage" Margin="16" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </Grid>
            </SplitView.Pane>

        <Grid>
            <views:PageSurface x:Name="Pages" x:Uid="PageSurface" AutomationProperties.AutomationId="PageSurface" Visibility="Collapsed" />

            <!-- Find in the document (Ctrl+F). -->
            <Border x:Name="FindBar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,24,0" Padding="8" CornerRadius="8"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    AutomationProperties.AutomationId="FindBar" PreviewKeyDown="OnFindBarKeyDown">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox x:Name="FindBox" x:Uid="FindBox" AutomationProperties.AutomationId="FindBox" Width="220" TextChanged="OnFindTextChanged" MaxLength="128" />
                    <TextBlock x:Name="FindStatus" AutomationProperties.AutomationId="FindStatus" AutomationProperties.LiveSetting="Polite" MinWidth="110" Margin="4,0"
                               VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="FindPreviousButton" x:Uid="FindPreviousButton" AutomationProperties.AutomationId="FindPreviousButton">
                        <FontIcon Glyph="&#xE70E;" FontSize="14" />
                    </Button>
                    <Button x:Name="FindNextButton" x:Uid="FindNextButton" AutomationProperties.AutomationId="FindNextButton">
                        <FontIcon Glyph="&#xE70D;" FontSize="14" />
                    </Button>
                    <ToggleButton x:Name="FindMatchCaseToggle" x:Uid="FindMatchCaseToggle" AutomationProperties.AutomationId="FindMatchCaseToggle" Checked="OnFindOptionChanged" Unchecked="OnFindOptionChanged" />
                    <ToggleButton x:Name="FindWholeWordToggle" x:Uid="FindWholeWordToggle" AutomationProperties.AutomationId="FindWholeWordToggle" Checked="OnFindOptionChanged" Unchecked="OnFindOptionChanged" />
                    <ToggleButton x:Name="FindRegexToggle" x:Uid="FindRegexToggle" AutomationProperties.AutomationId="FindRegexToggle" Checked="OnFindRegexChanged" Unchecked="OnFindRegexChanged" />
                    <Button x:Name="FindCloseButton" x:Uid="FindCloseButton" AutomationProperties.AutomationId="FindCloseButton">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Empty state: recent files, and the ways to open a PDF. -->
            <ScrollViewer x:Name="EmptyState" AutomationProperties.AutomationId="EmptyState" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="640" Margin="24,32,24,24" Spacing="16" HorizontalAlignment="Center">
                    <TextBlock x:Uid="EmptyTitle" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="EmptyTitle" />
                    <TextBlock x:Uid="EmptyHint" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                    <Button x:Name="EmptyOpenButton" x:Uid="EmptyOpenButton" AutomationProperties.AutomationId="EmptyOpenButton" Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock x:Uid="RecentHeading" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                    <TextBlock x:Name="NoRecentText" x:Uid="NoRecent" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="RecentList" x:Uid="RecentList" AutomationProperties.AutomationId="RecentList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="OnRecentClick" Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="app:RecentItem">
                                <StackPanel Padding="0,6" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Folder}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <!-- A restored tab whose file could not be found (or could not be opened): the file name, why, and the two things to do. -->
            <StackPanel x:Name="MissingPanel" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24"
                        AutomationProperties.AutomationId="MissingPanel">
                <FontIcon Glyph="&#xE7BA;" FontSize="40" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="MissingName" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="MissingName"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Name="MissingText" TextWrapping="Wrap" AutomationProperties.AutomationId="MissingText" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="LocateButton" AutomationProperties.AutomationId="LocateButton" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="MissingCloseButton" AutomationProperties.AutomationId="MissingCloseButton" />
                </StackPanel>
            </StackPanel>

            <!-- The element a tab move or close is announced from, as a UIA notification (docs/features/tabs-windows-session.md 5): one announcement each, no live region that would say it twice. -->
            <TextBlock x:Name="TabAnnouncement" Width="1" Height="1" Opacity="0" AutomationProperties.AutomationId="TabAnnouncement" />

            <!-- Settings (Ctrl+,): a page over the document area. -->
            <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed" AutomationProperties.AutomationId="SettingsPage" />
            <InfoBar x:Name="Banner" AutomationProperties.AutomationId="Banner" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,8,16,0" MaxWidth="720"
                     IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="BannerAction" AutomationProperties.AutomationId="BannerAction" Visibility="Collapsed" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Presentation mode (Ctrl+L): the black or white screen over the page, the page-number bar with Exit, and the page being typed. Collapsed (so not in the accessibility tree) except while they show. -->
            <Border x:Name="BlankScreen" Visibility="Collapsed" Background="Black" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <Border x:Name="PresentationGoTo" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,12" CornerRadius="8" Background="#CC000000"
                    AutomationProperties.AccessibilityView="Raw">
                <TextBlock x:Name="PresentationGoToText" Foreground="White" FontSize="28" />
            </Border>
            <Border x:Name="PresentationHint" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Padding="12,6" CornerRadius="8"
                    Background="#CC202020" AutomationProperties.AutomationId="PresentationHint" PointerEntered="OnPresentationHintEntered" PointerExited="OnPresentationHintExited">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="PresentationEscText" Foreground="White" VerticalAlignment="Center" AutomationProperties.AutomationId="PresentationEscText" />
                    <TextBlock x:Name="PresentationPageText" Foreground="White" VerticalAlignment="Center" AutomationProperties.AutomationId="PresentationPage" />
                    <Button x:Name="PresentationExit" AutomationProperties.AutomationId="PresentationExit" />
                </StackPanel>
            </Border>

            <ProgressRing x:Name="Busy" x:Uid="Busy" AutomationProperties.AutomationId="Busy" IsActive="False" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        </SplitView>

        <!-- The command palette (Ctrl+Shift+P): over the top centre of the window. -->
        <views:CommandPaletteView x:Name="Palette" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,4,16,0" />
    </Grid>
</Window>
