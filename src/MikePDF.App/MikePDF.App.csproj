<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MikePDF.App: the WinUI 3 reader. UI and broker only: it never parses PDF bytes and never loads PDFium (master prompt 5.1). Everything about a
    document goes through MikePDF.Broker to the sandboxed MikePDF.Engine.exe.
    No telemetry and no network calls (master prompt 14); PrivacyTests (tests/MikePDF.Core.Tests) fail if any networking or telemetry API shows up in this project's code or in the manifest.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MikePDF</AssemblyName>
    <RootNamespace>MikePDF.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <RuntimeIdentifier>$(MikePDFRuntimeIdentifier)</RuntimeIdentifier>
    <PlatformTarget>$(MikePDFArch)</PlatformTarget>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Our own Main (single-instance redirection must run before any XAML). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Test builds only (build/package.ps1 -TestBuild): a command-line self-test of the installed package. Never in a release package. -->
    <DefineConstants Condition="'$(MikePDFSelfTest)' == 'true'">$(DefineConstants);MIKEPDF_SELFTEST</DefineConstants>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <!-- The MSIX tooling forces MaxVersionTested to the SDK's version; PatchMaxVersionTested below sets it (S6 finding). -->
    <AppxOSMinVersionReplaceManifestVersion>false</AppxOSMinVersionReplaceManifestVersion>
    <AppxOSMaxVersionTestedReplaceManifestVersion>false</AppxOSMaxVersionTestedReplaceManifestVersion>
    <!--
      ReadyToRun (set by build/package.ps1) now; Native AOT later. AOT needs: source-generated COM instead of [ComImport] (S6), no reflection-based
      JSON (already source-generated), x:Bind instead of {Binding}, the arm64 linker (VS C++ ARM64 tools), and a re-run of S6 on the shipped XAML.
    -->
    <NoWarn>$(NoWarn);CA1812;CA1515</NoWarn>
    <!--
      Install size (master prompt 11: 60 MB unpacked per architecture; docs/perf/install-size.md). The published app is trimmed: the untrimmed self-contained
      package was 150 MB, of which the whole .NET library set, the 25 MB Windows SDK projection and the 16 MB WinUI projection were mostly unused. Only a self-contained
      publish trims (the trimmer refuses a framework-dependent build, which the development build is); the trim analyser runs on every build of this project, so a reflection
      pattern the trimmer cannot see is a compiler warning (and, with warnings as errors, a failed build).
    -->
    <PublishTrimmed Condition="'$(SelfContained)' == 'true'">true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!--
      C#/WinRT: a class that implements a WinRT interface (UI Automation's ITextProvider, ...) must be partial, so that its source generator writes the interface table the
      runtime would otherwise find by reflection, which the trimmer breaks (CsWinRT1028). Level 1 makes the analyser run on every build. ThumbnailItem and ThumbnailPages
      (a list view's items and its bindable collection) are partial for the same reason, though level 1 does not report them.
    -->
    <CsWinRTAotWarningLevel>1</CsWinRTAotWarningLevel>
    <!--
      IL2104 ("assembly X produced trim warnings") is the one summary warning the trimmer gives for an assembly we do not build. Two of them are known and cannot be
      fixed here: WinRT.Runtime and Microsoft.Windows.SDK.NET, the C#/WinRT 2.2.0 runtime and the Windows SDK projection that the .NET SDK itself references (35 IL2081
      in the generic ABI fallbacks of WinRT.Runtime, found with TrimmerSingleWarn=false). They stay visible as warnings; build/package.ps1 fails if IL2104 names any other
      assembly, and every warning in our own assemblies is still an error.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- MIT. The trimmer and the trim/AOT analysers. The SDK adds this package by itself at the version of whichever SDK patch is installed, which would change the lock files at every SDK update (NU1004 in CI, which floats to the latest 10.0.4xx), so it is named here. A build tool: nothing from it is shipped. The same line is in Core, Broker, Protocol and Printing. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" VersionOverride="10.0.14" PrivateAssets="all" />
    <ProjectReference Include="..\MikePDF.Core\MikePDF.Core.csproj" />
    <ProjectReference Include="..\MikePDF.Broker\MikePDF.Broker.csproj" />
    <ProjectReference Include="..\MikePDF.Protocol\MikePDF.Protocol.csproj" />
    <ProjectReference Include="..\MikePDF.Printing\MikePDF.Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MikePDF.UI.Tests" />
  </ItemGroup>

  <!--
    The engine rides along beside the app, in Engine\ (MikePDF.Engine.exe + pdfium.dll), taken from the CMake output when it exists, and runs in place
    from there (ADR-0004 A2). build/package.ps1 builds it first. Without it the app starts and reports that the engine is missing.
  -->
  <PropertyGroup>
    <MikePDFEngineDir Condition="'$(MikePDFEngineDir)' == ''">$(MSBuildThisFileDirectory)..\..\build\out\cmake-$(MikePDFArch)\bin\Release\</MikePDFEngineDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MikePDFEngineDir)MikePDF.Engine.exe')">
    <Content Include="$(MikePDFEngineDir)MikePDF.Engine.exe" Link="Engine\MikePDF.Engine.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(MikePDFEngineDir)pdfium.dll" Link="Engine\pdfium.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Package size (master prompt 11: 60 MB per architecture). MikePDF uses none of the Windows AI, ML or Search APIs, but the Windows App SDK
    metapackage binplaces ONNX Runtime and DirectML (about 38 MB) and their projections next to the app. They are left out of what is published.
    The Windows SDK projection (Microsoft.Windows.SDK.NET.dll, 25 MB of IL) is not ReadyToRun-compiled: that would more than double it, and MikePDF
    calls only a handful of Windows APIs at startup.
  -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>
  <Target Name="LeaveOutUnusedWindowsAppSdkParts" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_Unused Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'mscordaccore.dll' Or '%(Filename)%(Extension)' == 'mscordbi.dll' Or $([System.String]::new('%(Filename)').StartsWith('mscordaccore_')) Or '%(Filename)%(Extension)' == 'clrgcexp.dll' Or '%(Filename)%(Extension)' == 'clrgc.dll' Or '%(Filename)%(Extension)' == 'msquic.dll' Or $([System.String]::new('%(Filename)').StartsWith('Microsoft.DiaSymReader.Native')) Or '%(Filename)%(Extension)' == 'createdump.exe'" />
      <_Unused Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'onnxruntime.dll' Or '%(Filename)%(Extension)' == 'DirectML.dll' Or '%(Filename)%(Extension)' == 'Microsoft.ML.OnnxRuntime.dll' Or '%(Filename)%(Extension)' == 'Microsoft.Windows.AI.MachineLearning.dll' Or $([System.String]::new('%(Filename)').StartsWith('Microsoft.Windows.AI.'))" />
      <ResolvedFileToPublish Remove="@(_Unused)" />
    </ItemGroup>
  </Target>

  <!-- S6: the tooling forces MaxVersionTested to the TFM's SDK version (26100). ADR-0001 wants 26300. -->
  <Target Name="PatchMaxVersionTested" AfterTargets="Build" Condition="'$(WindowsPackageType)' == 'MSIX' and Exists('$(OutDir)AppxManifest.xml')">
    <PropertyGroup>
      <_Mf>$([System.IO.File]::ReadAllText('$(OutDir)AppxManifest.xml'))</_Mf>
      <_Mf2>$(_Mf.Replace('MaxVersionTested="10.0.26100.0"','MaxVersionTested="10.0.26300.0"'))</_Mf2>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutDir)AppxManifest.xml" Lines="$(_Mf2)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>
</Project>
