<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Printing from the broker: the printers, the DEVMODE and capabilities the driver reports, the GDI device, and the job that sends engine bands to it (ADR-0011).</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <!-- MIT, build tool, pinned so that an SDK update does not change the lock files: see MikePDF.App.csproj. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" VersionOverride="10.0.14" PrivateAssets="all" />
    <ProjectReference Include="..\MikePDF.Core\MikePDF.Core.csproj" />
    <ProjectReference Include="..\MikePDF.Broker\MikePDF.Broker.csproj" />
    <ProjectReference Include="..\MikePDF.Protocol\MikePDF.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MikePDF.Integration.Tests" />
  </ItemGroup>
</Project>
