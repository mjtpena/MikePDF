#pragma code_page(65001)
#include <winres.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MikePDF contributors"
            VALUE "FileDescription", "MikePDF thumbnail provider and preview handler for PDF files"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "MikePDF.ShellExt"
            VALUE "OriginalFilename", "MikePDF.ShellExt.dll"
            VALUE "ProductName", "MikePDF"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

STRINGTABLE
BEGIN
    IDS_PREVIEW_NAME "PDF preview"
    IDS_PREVIEW_VALUE "Page {0} of {1}"
    IDS_PREVIEW_LOADING "Loading..."
    IDS_PREVIEW_UNAVAILABLE "Preview isn't available for this file"
    IDS_PREVIEW_PASSWORD "This file is protected by a password. Open it in MikePDF to read it."
    IDS_PREVIEW_OFF "Preview is turned off"
    IDS_PREVIEW_OFF_POLICY "Preview is turned off by your organisation"
END
