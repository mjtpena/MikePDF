<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Engine launcher (AppContainer sandbox), pipe server, watchdog and respawn (ADR-0004, ADR-0005).</Description>
  </PropertyGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <ProjectReference Include="..\Quire.Protocol\Quire.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The integration tests drive internals (the engine instance, the slot ring's child handle) that no product caller should touch. -->
    <InternalsVisibleTo Include="Quire.Integration.Tests" />
  </ItemGroup>
</Project>
