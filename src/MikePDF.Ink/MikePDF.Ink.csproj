<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Trim and AOT analysers on every build: the writer host that reaches this library through MikePDF.Markup is Native AOT. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Ink stroke model, pressure curves, smoothing, simplification, outline and Bezier fitting, eraser geometry and batching. No UI, no IPC, no dependencies (ADR-0007).</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- MIT, build tool, pinned so that an SDK update does not change the lock files: see MikePDF.App.csproj. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" VersionOverride="10.0.14" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MikePDF.Ink.Tests" />
  </ItemGroup>
</Project>
