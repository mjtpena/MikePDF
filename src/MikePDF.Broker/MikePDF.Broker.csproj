<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Engine launcher (AppContainer sandbox), pipe server, watchdog and respawn (ADR-0004, ADR-0005).</Description>
  </PropertyGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <!-- MIT, build tool, pinned so that an SDK update does not change the lock files: see MikePDF.App.csproj. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" VersionOverride="10.0.14" PrivateAssets="all" />
    <ProjectReference Include="..\MikePDF.Core\MikePDF.Core.csproj" />
    <ProjectReference Include="..\MikePDF.Protocol\MikePDF.Protocol.csproj" />
    <!-- The save coordinator turns the pending annotation commands into the edit blob with the mapper that lives there. -->
    <ProjectReference Include="..\MikePDF.Markup.Editing\MikePDF.Markup.Editing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The integration tests drive internals (the engine instance, the slot ring's child handle) that no product caller should touch. -->
    <InternalsVisibleTo Include="MikePDF.Integration.Tests" />
  </ItemGroup>
</Project>
