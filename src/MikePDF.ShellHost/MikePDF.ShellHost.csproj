<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window when a Windows Explorer host starts it. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>MikePDF.ShellHost</AssemblyName>
    <RootNamespace>MikePDF.ShellHost</RootNamespace>
    <Description>The broker for File Explorer's thumbnail provider and preview handler (ADR-0018): a per-user pipe, a fresh sandboxed engine per file, pixels back in a section the handler made.</Description>
    <RuntimeIdentifier>$(MikePDFRuntimeIdentifier)</RuntimeIdentifier>
    <!-- Native AOT (ADR-0018 decision 1): cold start 110 ms against 274 ms for a JIT build in S6b. The analyzers run on every build, the compiler on publish. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The only packages this project restores are the SDK's own Native AOT toolchain (Microsoft.DotNet.ILCompiler and its runtime pack, Microsoft.NET.ILLink.Tasks), whose version is
         the SDK's: a lock file written by one SDK patch is refused by the next (NU1004 in CI). Everything ShellHost uses at run time comes from project references, which the
         locked projects that reference it (the integration tests, the fuzz harness) still pin. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Stack traces and exception messages are for the log file only; nothing here is shown to a person. -->
    <StackTraceSupport>true</StackTraceSupport>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MikePDF.Broker\MikePDF.Broker.csproj" />
    <ProjectReference Include="..\MikePDF.Core\MikePDF.Core.csproj" />
    <ProjectReference Include="..\MikePDF.Protocol\MikePDF.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MikePDF.Integration.Tests" />
    <InternalsVisibleTo Include="MikePDF.Fuzz.Tests" />
    <InternalsVisibleTo Include="MikePDF.ShellHost.Fuzz" />
  </ItemGroup>
</Project>
