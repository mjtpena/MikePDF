# Auto detect text files and perform LF normalization
* text=auto

# Binary formats: never line-ending convert (PDF xref offsets are byte-exact)
*.pdf  binary
*.png  binary
*.jpg  binary
*.pfx  binary
*.dll  binary
*.exe  binary
*.tgz  binary
*.zip  binary
*.bin binary

# Journal files and their fuzz seeds: every line carries a checksum of its bytes, so a line ending must never be converted
*.jsonl -text
