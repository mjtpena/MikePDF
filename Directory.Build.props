<Project>
  <!-- Shared settings for every C# project. Native code is built by CMake (see CMakeLists.txt). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML docs on public members. Docs are required at review, not per-member by the compiler. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <Company>MikePDF</Company>
    <Product>MikePDF</Product>
    <!-- Target architecture for executables (x64 | arm64). Libraries stay AnyCPU. build.ps1 passes it. -->
    <MikePDFArch Condition="'$(MikePDFArch)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</MikePDFArch>
    <MikePDFRuntimeIdentifier>win-$(MikePDFArch)</MikePDFRuntimeIdentifier>
    <!-- Both RIDs in every lock file, so locked-mode restore works on either CI architecture. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>$(MikePDFRuntimeIdentifier)</RuntimeIdentifier>
    <!-- Test code may use underscores in names and skip ConfigureAwait. -->
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
