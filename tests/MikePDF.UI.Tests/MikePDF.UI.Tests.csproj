<Project Sdk="Microsoft.NET.Sdk">
  <!--
    FlaUI UI smoke tests (ADR-0009). They need an interactive desktop and an installed (or loosely registered) MikePDF package, so they run from
    build/run-ui-tests.ps1, not from build.ps1 -Test: without MIKEPDF_UI_TESTS=1 every test here is skipped.
  -->
  <PropertyGroup>
    <!-- The page objects are the only code that knows FlaUI (ADR-0009). Test code may skip ConfigureAwait and use underscores. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <!-- The page object reads the clipboard and moves the window with P/Invoke (LibraryImport, source generated). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The print journeys check the file a print wrote: how many pages, how big, and how much each looks like the page it came from (journey 11, PRINT-13). That takes the sandboxed engine, the page geometry
      the app prints with, and the comparison the print tests use (linked from them), not FlaUI.
    -->
    <ProjectReference Include="..\..\src\MikePDF.Broker\MikePDF.Broker.csproj" />
    <ProjectReference Include="..\..\src\MikePDF.Core\MikePDF.Core.csproj" />
    <ProjectReference Include="..\..\src\MikePDF.Printing\MikePDF.Printing.csproj" />
    <ProjectReference Include="..\..\src\MikePDF.Protocol\MikePDF.Protocol.csproj" />
    <Compile Include="..\..\tools\MikePDF.Render\Imaging\Ssim.cs" Link="Printing\Linked\Ssim.cs" />
    <Compile Include="..\..\tools\MikePDF.Render\Imaging\BgraImage.cs" Link="Printing\Linked\BgraImage.cs" />
    <Compile Include="..\MikePDF.Integration.Tests\Printing\PageImages.cs" Link="Printing\Linked\PageImages.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fixtures shared with the integration tests (PDFium test PDFs, BSD-3-Clause). -->
    <Content Include="..\MikePDF.Integration.Tests\Fixtures\*.pdf" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
