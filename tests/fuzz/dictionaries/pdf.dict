# Dictionary for the PDF targets (PdfWriter parser, engine document load). Format: libFuzzer / AFL.

# Structure
header="%PDF-1.7\x0A"
header_2="%PDF-2.0\x0D"
binary_comment="%\xE2\xE3\xCF\xD3\x0A"
obj="\x0A1 0 obj\x0A"
obj_gen="\x0A2 65535 obj\x0A"
endobj="\x0Aendobj\x0A"
stream="stream\x0D\x0A"
stream_lf="stream\x0A"
endstream="\x0Aendstream"
xref="xref\x0A0 1\x0A0000000000 65535 f \x0A"
xref_entry="0000000015 00000 n \x0A"
xref_entry_free="0000000000 00001 f \x0A"
trailer="trailer\x0A<< /Size 1 /Root 1 0 R >>\x0A"
startxref="startxref\x0A0\x0A%%EOF\x0A"
eof="%%EOF"
startxref_kw="startxref"
tok_xref="xref"
tok_trailer="trailer"
tok_stream="stream"
tok_endstream="endstream"
tok_endobj="endobj"
ref="1 0 R"
ref_big="4294967295 0 R"
ref_neg="-1 0 R"
ref_self="1 0 R 1 0 R"

# Delimiters and tokens
dict_open="<<"
dict_close=">>"
arr_open="["
arr_close="]"
paren="("
paren_close=")"
hex_open="<"
hex_close=">"
t_true="true"
t_false="false"
t_null="null"
comment="%"
nested_dict="<< /A << /B << /C"
nested_array="[[[[[[[[[[[[[[[["
escape_octal="\\377"
escape_cr="\\\x0D"

# Names
n_type="/Type"
n_catalog="/Catalog"
n_pages="/Pages"
n_page="/Page"
n_kids="/Kids"
n_count="/Count"
n_parent="/Parent"
n_mediabox="/MediaBox [0 0 612 792]"
n_cropbox="/CropBox"
n_rotate="/Rotate 90"
n_contents="/Contents"
n_resources="/Resources"
n_font="/Font"
n_length="/Length"
n_length_ref="/Length 1 0 R"
n_filter="/Filter"
n_flate="/FlateDecode"
n_lzw="/LZWDecode"
n_a85="/ASCII85Decode"
n_ahx="/ASCIIHexDecode"
n_rl="/RunLengthDecode"
n_dct="/DCTDecode"
n_ccitt="/CCITTFaxDecode"
n_jbig2="/JBIG2Decode"
n_jpx="/JPXDecode"
n_crypt="/Crypt"
n_decodeparms="/DecodeParms"
n_predictor="/Predictor 12"
n_columns="/Columns 4"
n_colors="/Colors 3"
n_bpc="/BitsPerComponent 8"
n_xref="/XRef"
n_objstm="/ObjStm"
n_w="/W [1 2 1]"
n_w_big="/W [8 8 8]"
n_index="/Index [0 1]"
n_prev="/Prev 0"
n_xrefstm="/XRefStm 0"
n_size="/Size 4294967295"
n_root="/Root"
n_info="/Info"
n_id="/ID [<00> <00>]"
n_encrypt="/Encrypt"
n_first="/First"
n_n="/N 2"
n_extends="/Extends"
n_linearized="/Linearized 1"
n_annots="/Annots"
n_subtype="/Subtype"
n_link="/Link"
n_widget="/Widget"
n_a="/A"
n_uri="/URI"
n_s="/S"
n_dest="/Dest"
n_outlines="/Outlines"
n_first_kw="/First"
n_next="/Next"
n_acroform="/AcroForm"
n_fields="/Fields"
n_names="/Names"
n_javascript="/JS"
n_ef="/EF"
n_embedded="/EmbeddedFile"
n_v="/V"
n_ft="/FT"
n_sig="/Sig"
n_byterange="/ByteRange [0 1 2 3]"
n_hash_escape="/A#00B"

# Content stream operators
op_q="q\x0A"
op_cm="1 0 0 1 0 0 cm\x0A"
op_re="0 0 100 100 re f\x0A"
op_bt="BT /F1 12 Tf (x) Tj ET\x0A"
op_inline_image="BI /W 1 /H 1 /CS /G /BPC 8 ID \x00 EI\x0A"
op_sh="/Sh0 sh\x0A"
op_do="/Im0 Do\x0A"
op_huge_dash="[1e30] 0 d\x0A"
op_huge_number="99999999999999999999999 0 m\x0A"

# Numbers and boundaries
num_i32max="2147483647"
num_i32min="-2147483648"
num_u32max="4294967295"
num_i64max="9223372036854775807"
num_i64over="9223372036854775808"
num_real_big="1e308"
num_real_tiny=".0000000000000000001"
num_neg_real="-.5"
num_plus="+7"
num_double_dot="1.2.3"
num_leading_zeros="0000000000000000000000001"
nul="\x00"
