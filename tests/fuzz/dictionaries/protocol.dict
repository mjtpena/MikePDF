# Dictionary for the IPC decoders (both languages). Format: libFuzzer / AFL. See docs/fuzzing.md.
# Frame = u32le bodyLength + MessagePack body; the largest legal body is 65536 bytes (ADR-0005).

# Frame length prefixes (little endian): 1, 8, 255, 256, 65535, 65536 (the limit), 65537 (one too many), 0, and "huge".
len_1="\x01\x00\x00\x00"
len_8="\x08\x00\x00\x00"
len_ff="\xFF\x00\x00\x00"
len_100="\x00\x01\x00\x00"
len_ffff="\xFF\xFF\x00\x00"
len_max="\x00\x00\x01\x00"
len_over="\x01\x00\x01\x00"
len_zero="\x00\x00\x00\x00"
len_huge="\xFF\xFF\xFF\xFF"

# Envelope headers: a request is a 5-array, a response a 4-array. Wrong arities are rejected, so try neighbours too.
arr3="\x93"
arr4="\x94"
arr5="\x95"
arr6="\x96"
arr16="\xDC\x00\x10"
arr_big16="\xDC\xFF\xFF"
arr_big32="\xDD\xFF\xFF\xFF\xFF"
arr_1024="\xDC\x04\x00"
arr_2049="\xDC\x08\x01"
map1="\x81"
map_big16="\xDE\xFF\xFF"
map_big32="\xDF\xFF\xFF\xFF\xFF"

# MessagePack scalars.
nil="\xC0"
false="\xC2"
true="\xC3"
uint8_ff="\xCC\xFF"
uint16_max="\xCD\xFF\xFF"
uint16_0100="\xCD\x01\x00"
uint32_max="\xCE\xFF\xFF\xFF\xFF"
uint32_8000="\xCE\x80\x00\x00\x00"
uint32_00010000="\xCE\x00\x01\x00\x00"
uint64_max="\xCF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF"
uint64_8000="\xCF\x80\x00\x00\x00\x00\x00\x00\x00"
int8_min="\xD0\x80"
int8_m1="\xD0\xFF"
int16_min="\xD1\x80\x00"
int32_min="\xD2\x80\x00\x00\x00"
int32_max="\xD2\x7F\xFF\xFF\xFF"
int64_min="\xD3\x80\x00\x00\x00\x00\x00\x00\x00"
neg_fixint="\xFF"
neg_fixint_32="\xE0"
pos_fixint_7f="\x7F"

# Floats: NaN, +/-Infinity, negative zero, and the schema's range edges (scale 0.01 and 64, page sizes 14400, coordinates 1e6).
f32_nan="\xCA\x7F\xC0\x00\x00"
f32_inf="\xCA\x7F\x80\x00\x00"
f32_ninf="\xCA\xFF\x80\x00\x00"
f32_nzero="\xCA\x80\x00\x00\x00"
f32_zero="\xCA\x00\x00\x00\x00"
f32_one="\xCA\x3F\x80\x00\x00"
f32_64="\xCA\x42\x80\x00\x00"
f32_001="\xCA\x3C\x23\xD7\x0A"
f32_14400="\xCA\x46\x61\x20\x00"
f32_1e6="\xCA\x49\x74\x24\x00"
f32_denormal="\xCA\x00\x00\x00\x01"
f32_max="\xCA\x7F\x7F\xFF\xFF"
f64_nan="\xCB\x7F\xF8\x00\x00\x00\x00\x00\x00"
f64_inf="\xCB\x7F\xF0\x00\x00\x00\x00\x00\x00"
f64_one="\xCB\x3F\xF0\x00\x00\x00\x00\x00\x00"

# Strings and binary. Text must be strict UTF-8 without NUL; try overlong forms, surrogates, NUL and over-length headers.
str_empty="\xA0"
str_1="\xA1"
str_31="\xBF"
str8_ff="\xD9\xFF"
str8_80="\xD9\x80"
str16_0400="\xDA\x04\x00"
str16_0401="\xDA\x04\x01"
str16_ffff="\xDA\xFF\xFF"
str32_big="\xDB\xFF\xFF\xFF\xFF"
bin8_ff="\xC4\xFF"
bin16_ffff="\xC5\xFF\xFF"
bin32_big="\xC6\xFF\xFF\xFF\xFF"
ext1="\xD4\x00\x00"
utf8_overlong_slash="\xC0\xAF"
utf8_overlong_nul="\xC0\x80"
utf8_surrogate="\xED\xA0\x80"
utf8_above_10ffff="\xF4\x90\x80\x80"
utf8_f8="\xF8\x88\x80\x80\x80"
utf8_truncated="\xE2\x82"
utf8_bom="\xEF\xBB\xBF"
utf8_max="\xF4\x8F\xBF\xBF"
nul_byte="\x00"

# Message type identifiers (MessagePack positive fixint / uint16): Hello, Ping, Shutdown, AttachSlotRing, OpenDocument, CloseDocument,
# GetDocumentInfo, GetPageSizes, GetOutline, GetPageLinks, GetLinkUri, GetPageBoxes, GetPageText, SearchPage, RenderTile, CancelBefore,
# ValidateStructure (1024), and some undefined neighbours.
type_hello="\x01"
type_ping="\x02"
type_shutdown="\x03"
type_attach="\x04"
type_open="\x10"
type_close="\x11"
type_info="\x12"
type_sizes="\x13"
type_outline="\x14"
type_links="\x15"
type_linkuri="\x16"
type_boxes="\x17"
type_text="\x18"
type_search="\x19"
type_render="\x20"
type_cancel="\x21"
type_validate="\xCD\x04\x00"
type_undefined_5="\x05"
type_undefined_26="\x1A"
type_undefined_34="\x22"
type_undefined_1025="\xCD\x04\x01"

# Status codes in responses (0 Ok ... 12 PermissionDenied) and one past the end.
status_ok="\x00"
status_timeout="\x0A"
status_denied="\x0C"
status_undefined="\x0D"

# Limits from the schema, as uint16/uint32 pairs that sit exactly on and just over an edge.
lim_1024="\xCD\x04\x00"
lim_1025="\xCD\x04\x01"
lim_5000="\xCD\x13\x88"
lim_5001="\xCD\x13\x89"
lim_2048="\xCD\x08\x00"
lim_2049="\xCD\x08\x01"
lim_512="\xCD\x02\x00"
lim_513="\xCD\x02\x01"
lim_200000="\xCE\x00\x03\x0D\x40"
lim_200001="\xCE\x00\x03\x0D\x41"
lim_9999999="\xCE\x00\x98\x96\x7F"
lim_10000000="\xCE\x00\x98\x96\x80"
lim_16777216="\xCE\x01\x00\x00\x00"
lim_deadline_max="\xCE\x05\x26\x5C\x00"
lim_deadline_over="\xCE\x05\x26\x5C\x01"
