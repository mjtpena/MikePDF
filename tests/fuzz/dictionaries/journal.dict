# Dictionary for the edit journal's reader (save-pipeline 3.4). Format: libFuzzer / AFL. See docs/fuzzing.md.
# A line is JSON ending in ,"crc":"hhhhhhhh"} and LF; the checksum covers everything before that suffix, so the fuzzer cannot get past it by
# luck: the seeds carry valid lines, and these tokens are for the fields and the shapes around them.

suffix=",\"crc\":\""
close="\"}\x0A"
open_v="{\"v\":1,"
type_header="\"type\":\"header\","
seq="\"seq\":"
time="\"t\":\"2026-11-03T10:30:00.123Z\","
cmd="\"cmd\":\""
cmd_add="AddAnnotation"
cmd_update="UpdateAnnotation"
cmd_delete="DeleteAnnotation"
cmd_field="SetFieldValue"
cmd_undo="Undo"
cmd_redo="Redo"
cmd_intent="SaveIntent"
cmd_begin="SaveBegin"
cmd_committed="SaveCommitted"
cmd_discard="Discard"
cmd_unknown="FutureThing"
field_target="\"target\":"
field_temp="\"temp\":\""
field_backup="\"backup\":\""
field_save_target="\"saveTarget\":\""
field_sha="\"outputSha256\":\""
field_length="\"outputLength\":"
field_doc_path="\"docPath\":\""
field_fingerprint="\"fingerprint\":\""
field_pages="\"pages\":["
field_size="\"size\":"
field_app="\"app\":\""
tmp_name="\\.a.pdf.mikepdf-0a1b2c3d.tmp"
bak_name="\\.a.pdf.mikepdf-0a1b2c3d.bak"
unc="\\\\\\\\server\\\\share\\\\"
extended="\\\\\\\\?\\\\C:\\\\"
dup_key="\"v\":1,\"v\":1,"
deep="[[[[[[[[[[[[[[[[[[[["
escape_u="\\u00e9"
escape_surrogate="\\ud800"
nul="\\u0000"
big="99999999999999999999"
neg="-1"
