<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Fuzz harness for MikePDF.PdfWriter (parse + validate, incremental append round trip, stage 4 and the copies) and for the save pipeline's journal and edit blob readers: a dependency-free mutational fuzzer and SharpFuzz entry points.</Description>
    <NoWarn>$(NoWarn);CA5394</NoWarn>
    <!-- LibraryImport (SetErrorMode in MutationalFuzzer) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Fuzz targets deliberately catch nothing: any exception that escapes is the finding. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\MikePDF.PdfWriter\MikePDF.PdfWriter.csproj" />
    <!-- The save targets: the edit journal and recovery (Core) and the edit blob codec (Protocol). -->
    <ProjectReference Include="..\..\..\src\MikePDF.Core\MikePDF.Core.csproj" />
    <ProjectReference Include="..\..\..\src\MikePDF.Protocol\MikePDF.Protocol.csproj" />
    <PackageReference Include="SharpFuzz" />
    <Compile Include="..\Shared\MutationalFuzzer.cs" Link="Shared\MutationalFuzzer.cs" />
    <Compile Include="..\Shared\LibFuzzerEntry.cs" Link="Shared\LibFuzzerEntry.cs" />
    <InternalsVisibleTo Include="MikePDF.Fuzz.Tests" />
  </ItemGroup>
</Project>
