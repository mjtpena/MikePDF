<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\Quire.Broker\Quire.Broker.csproj" />
    <!-- The tests compare the sandboxed host with an in-process validation of the same files (an oracle, not a product use). -->
    <ProjectReference Include="..\..\src\Quire.PdfWriter\Quire.PdfWriter.csproj" />
    <ProjectReference Include="..\..\src\Quire.Protocol\Quire.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Small PDFium test PDFs (BSD-3-Clause), see Fixtures/MANIFEST.md. -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Calls here use explicit timeouts; the per-test cancellation token adds nothing for engine round trips. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <!--
    The sandboxed WriterHost tests need the self-contained Quire.WriterHost build output. A project reference to a self-contained executable is
    refused by the SDK (NETSDK1151), so build it explicitly first; the fixture deploys the output into a directory the AppContainer may read.
  -->
  <Target Name="BuildWriterHost" BeforeTargets="BeforeBuild">
    <MSBuild Projects="..\..\src\Quire.WriterHost\Quire.WriterHost.csproj" Targets="Build" Properties="Configuration=$(Configuration);QuireArch=$(QuireArch)" />
  </Target>
</Project>
