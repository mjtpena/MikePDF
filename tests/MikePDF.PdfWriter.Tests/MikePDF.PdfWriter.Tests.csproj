  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MikePDF.PdfWriter\MikePDF.PdfWriter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- BSD-3-Clause PDFium test resources, see Fixtures/pdfium/MANIFEST.md -->
