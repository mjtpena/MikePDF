# S1.2 (NOT EXECUTED): GN args shared by all Quire PDFium configurations.
# Base is the pdfium-binaries Windows arg set (steps/05-configure.sh), which is also what the
# pinned prebuilt used (see spikes/_shared/pdfium/pdfium-win-x64/args.gn). target_cpu is appended by build.ps1.
is_debug = false
is_component_build = false          # one self-contained pdfium.dll; needs the shared_library patch (build.ps1)
pdf_is_standalone = true
pdf_use_partition_alloc = false
target_os = "win"
treat_warnings_as_errors = false    # pin-bump friendliness. Revisit for our own code, not for PDFium

